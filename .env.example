# Local development overrides. Git-ignored — never commit this file.

# Which settings module loads. manage.py defaults to `local`, wsgi.py to `prod`;
# the test suite uses `messycrm.settings.test` and needs no values from here.
# DJANGO_SETTINGS_MODULE=messycrm.settings.local

DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Parsed by dj-database-url. URL-encode the password if it has @ : / ? # or %.
DATABASE_URL=postgres://messycrm:change-me-to-a-random-password@localhost:5432/messycrm

# Required by compose.yml to create the database and role on first start.
# Must match DATABASE_URL. Only DATABASE_URL is needed in CI and production.
POSTGRES_USER=messycrm
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=messycrm
POSTGRES_PORT=5432

# --- Production only (messycrm.settings.prod) -------------------------------
# DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS and DATABASE_URL are mandatory there
# and have no defaults; DEBUG is always off. TLS is expected to be terminated by
# a reverse proxy that sets X-Forwarded-Proto, so these are on by default:
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=3600
